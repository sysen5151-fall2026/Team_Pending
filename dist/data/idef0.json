 "requirements": {
  "SYS-1.4.3": {
   "doc": "Biodiversity Risk Map Requirements",
   "type": "Functional (Ch 5)",
   "text": "The Biodiversity Risk Map shall Calculate Habitat Quality."
  },
  "SYS-2.1.2": {
   "doc": "Biodiversity Risk Map Requirements",
   "type": "System-wide (Performance)",
   "text": "The Biodiversity Risk Map shall return a site result within 3 s (95th percentile) for 10 concurrent users."
  },
  "SYS-2.1.4": {
   "doc": "Biodiversity Risk Map Requirements",
   "type": "System-wide (Performance)",
   "text": "The Biodiversity Risk Map shall produce reproducible results for identical inputs and parameters."
  },
  "SYS-2.1.5": {
   "doc": "Biodiversity Risk Map Requirements",
   "type": "System-wide",
   "text": "The Biodiversity Risk Map shall warn the user when a selected area has data gaps."
  },
  "SYS-2.4.5": {
   "doc": "Biodiversity Risk Map Requirements",
   "type": "System-wide (Interface)",
   "text": "The Biodiversity Risk Map shall trace every output to its data version and parameter set."
  },
  "HMS-1.1.1": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Input",
   "text": "The Habitat Modeling Subsystem shall accept Habitat-model parameters from the IT Development Team."
  },
  "HMS-1.1.2": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Input",
   "text": "The Habitat Modeling Subsystem shall accept Prepared datasets from the Data Preparation Subsystem."
  },
  "HMS-1.2.2": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Output",
   "text": "The Habitat Modeling Subsystem shall provide Habitat-quality and degradation results to the Spatial Analysis Subsystem."
  },
  "HMS-1.2.3": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Output",
   "text": "The Habitat Modeling Subsystem shall provide the Model run record to the Explanation Subsystem."
  },
  "HMS-1.3.1": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Interface",
   "text": "Interface with the Data Preparation Subsystem."
  },
  "HMS-1.3.2": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Interface",
   "text": "Interface with the Spatial Analysis Subsystem."
  },
  "HMS-1.3.3": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Interface",
   "text": "Interface with the Web Map Subsystem."
  },
  "HMS-1.3.4": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Interface",
   "text": "Interface with the Explanation Subsystem."
  },
  "HMS-1.4.1": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Functional",
   "text": "The Habitat Modeling Subsystem shall Assemble Model Inputs."
  },
  "HMS-1.4.2": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Functional",
   "text": "The Habitat Modeling Subsystem shall Configure Threat and Sensitivity Parameters."
  },
  "HMS-1.4.3": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Functional",
   "text": "The Habitat Modeling Subsystem shall Execute Habitat Quality Model."
  },
  "HMS-1.4.4": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Functional",
   "text": "The Habitat Modeling Subsystem shall Verify Model Outputs."
  },
  "HMS-1.4.5": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Functional",
   "text": "The Habitat Modeling Subsystem shall Classify Habitat Risk."
  },
  "HMS-1.4.6": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "Functional",
   "text": "The Habitat Modeling Subsystem shall Register Model Run."
  },
  "HMS-2.1.1": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "System-wide (flow-down)",
   "parent": "SYS-2.1.2",
   "method": "Apportionment",
   "text": "The Habitat Modeling Subsystem shall run off the user request path so that site requests read precomputed results (3 s budget: 1.5 s Spatial Analysis, 0.3 s Explanation, 1.2 s Web Map, 0 s Habitat Modeling)."
  },
  "HMS-2.1.3": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "System-wide (flow-down)",
   "parent": "SYS-2.1.4",
   "method": "Equivalence",
   "text": "The Habitat Modeling Subsystem shall produce habitat-quality values that differ by no more than 1e-6 between runs with the same inputs and parameter set."
  },
  "HMS-2.1.4": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "System-wide (flow-down)",
   "parent": "SYS-2.1.1",
   "method": "Equivalence",
   "text": "The Habitat Modeling Subsystem shall produce a result for every cell of the county grid."
  },
  "HMS-2.1.5": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "System-wide (flow-down)",
   "parent": "SYS-2.4.5",
   "method": "Synthesis",
   "text": "The Habitat Modeling Subsystem shall release no result that fails the output quality gate (values in [0,1], no missing cells)."
  },
  "HMS-2.1.6": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "System-wide (flow-down)",
   "parent": "SYS-2.1.7",
   "method": "Equivalence",
   "text": "Only the IT Development Team shall change habitat-model parameters; every change produces a new parameter-set identifier."
  },
  "HMS-2.3.1": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "System-wide (flow-down)",
   "parent": "SYS-2.3.1",
   "method": "Equivalence",
   "text": "The Habitat Modeling Subsystem shall use a pinned InVEST Habitat Quality release."
  },
  "HMS-2.3.2": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "System-wide (flow-down)",
   "parent": "SYS-2.3.2",
   "method": "Synthesis",
   "text": "Threat weights, distances, suitability and sensitivity shall be configuration, not code."
  },
  "HMS-2.4.2": {
   "doc": "Habitat Modeling Subsystem Requirements",
   "type": "System-wide (flow-down)",
   "parent": "SYS-2.4.5",
   "method": "Synthesis",
   "text": "Every model run shall produce a Model run record (run id, dataset id, parameter-set id, model version, QA result)."
  }
 },
